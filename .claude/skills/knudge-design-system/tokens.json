{
  "$meta": {
    "name": "Knudge Design System",
    "source": "KnowledgeNudge app",
    "stack": ["next@15", "react@19", "tailwindcss@4", "radix-ui", "lucide-react", "cva"],
    "font": "Manrope"
  },
  "color": {
    "brand": {
      "primary": "#C62B6D",
      "primaryHover": "#A02357",
      "secondary": "#334998",
      "default": "#C62B6D"
    },
    "semantic": {
      "success": "#129F66",
      "error": "#DB4C5C",
      "warning": "#C98900",
      "info": "#175CD3",
      "topPerforming": "#129F66",
      "needAttention": "#DB4C5C"
    },
    "status": {
      "live": "#175CD3",
      "draft": "#C98900",
      "concluded": "#1A932E",
      "scheduled": "#2D3D90",
      "closed": "#BA1515",
      "stopped": "#B5361A"
    },
    "text": {
      "primary": "#111827",
      "secondary": "#6B7280",
      "muted": "#9CA3AF"
    },
    "surface": {
      "background": "#F9FAFB",
      "surface": "#FFFFFF",
      "border": "#E5E7EB"
    },
    "chart": ["#C62B6D", "#129F66", "#DB4C5C", "#334998", "#10b981", "#ef4444", "#6366f1", "#f59e0b", "#3b82f6", "#8b5cf6"],
    "brandOpacityRamp": [0.12, 0.35, 0.75, 1]
  },
  "typography": {
    "fontFamily": "Manrope, ui-sans-serif, system-ui, sans-serif",
    "scale": {
      "display": "text-[2.75rem] xl:text-[3.25rem] font-bold leading-tight",
      "cardTitle": "text-2xl font-semibold leading-none tracking-tight",
      "sectionHeading": "text-xl font-bold",
      "subheading": "text-lg font-semibold",
      "body": "text-sm",
      "bodyLarge": "text-base",
      "label": "text-xs",
      "pill": "text-[10px] font-medium",
      "stat": "text-2xl font-bold"
    },
    "weights": { "medium": 500, "semibold": 600, "bold": 700 },
    "letterSpacingTight": "-0.02em"
  },
  "radius": {
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px",
    "input": "rounded-xl",
    "card": "rounded-2xl",
    "pill": "rounded-full"
  },
  "spacing": {
    "gridGap": "gap-6",
    "fieldStack": "space-y-4",
    "cardPadding": "p-6",
    "smallCardPadding": "p-5",
    "inputPadding": "px-4 py-3",
    "buttonPadding": "px-4 py-2",
    "pillPadding": "px-2 py-1.5",
    "pageContainer": "max-w-7xl mx-auto px-[40px] py-8"
  },
  "shadow": {
    "card": "shadow-sm",
    "tooltip": "shadow-md",
    "floating": "shadow-lg",
    "menu": "shadow-xl"
  },
  "border": {
    "default": "border border-gray-200",
    "divider": "divide-y divide-gray-50",
    "dashed": "border border-dashed border-gray-200"
  },
  "icon": {
    "library": "lucide-react",
    "sizes": { "micro": "h-3 w-3", "small": "h-3.5 w-3.5", "default": "h-4 w-4", "page": "h-5 w-5", "large": "h-6 w-6" },
    "color": "text-gray-400",
    "hover": "text-gray-600"
  },
  "component": {
    "button": {
      "base": "inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
      "variants": {
        "default": "bg-pink-600 text-white hover:bg-pink-700",
        "destructive": "bg-red-500 text-white hover:bg-red-600",
        "outline": "border border-gray-200 bg-white hover:bg-gray-50 text-gray-900",
        "ghost": "hover:bg-gray-100 text-gray-900",
        "secondary": "bg-gray-100 text-gray-900 hover:bg-gray-200"
      },
      "sizes": { "default": "h-10 px-4 py-2", "sm": "h-9 rounded-md px-3", "lg": "h-11 rounded-md px-8", "icon": "h-10 w-10" }
    },
    "input": "flex h-12 w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm placeholder:text-gray-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50",
    "card": "rounded-2xl border border-gray-200 bg-white text-gray-950 shadow-sm",
    "badge": "inline-flex items-center gap-0.5 w-fit rounded-full px-2 py-1.5 text-[10px] font-medium",
    "dialogContent": "fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg gap-4 translate-x-[-50%] translate-y-[-50%] rounded-2xl border border-gray-200 bg-white p-6 shadow-lg",
    "tableCell": "px-4 py-2.5 text-gray-700 text-sm",
    "tableHeader": "px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wide"
  },
  "theming": {
    "rule": "Never hardcode brand color for themeable surfaces. Apply via inline style.",
    "default": "#C62B6D",
    "apply": {
      "background": "style={{ backgroundColor: brandColor }}",
      "text": "style={{ color: brandColor }}",
      "border": "style={{ borderColor: brandColor }}",
      "ring": "style={{ '--tw-ring-color': brandColor }} + focus:ring-2",
      "accent": "style={{ accentColor: brandColor }}",
      "hover": "hover:opacity-90"
    }
  }
}
